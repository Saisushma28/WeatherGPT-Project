# WeatherGPT Backend Configuration

# Active Weather Provider: open_meteo (default, no key needed), openweather, weatherapi
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=9c9dedbb40941f2e04384eeef040ba24

# Active LLM Provider: rule_based (default fallback), gemini, openai, groq
LLM_PROVIDER=rule_based
LLM_API_KEY=GCP_API_KEY=your_gcp_api_key_here

# Geocoding Provider: open_meteo (default), nominatim
GEOCODING_PROVIDER=open_meteo
GEOCODING_API_KEY=

# Voice STT / TTS Provider: browser_fallback (default), whisper, google, azure
STT_PROVIDER=browser_fallback
STT_API_KEY=

TTS_PROVIDER=browser_fallback
TTS_API_KEY=

# Weather Warning Provider: imd_rules (default rule engine matching official IMD thresholds)
WEATHER_WARNING_PROVIDER=imd_rules
WEATHER_WARNING_API_KEY=

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
